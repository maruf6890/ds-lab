
import multiprocessing as mp
import os 
import time 
from pprint import pprint

DOCUMENTS = [
    "distributed systems are fun",
    "map reduce is a programming model",
    "the master splits input into map tasks",
    "reduce tasks sum the counts from map tasks",
    "fun fun fun distributed computing",
]
map_timeout = 2.0


def falky_map_task(doc_id,text, attempt):
    pid= os.getpid()

    print(
        f"[worker pid={pid}]"
        f"attept {attempt} "
    )
    if doc_id==1 and attempt==1:
        print(
            f"[MAP worker pid={pid}] "
            f"!! CRASHING on doc {doc_id} (simulated failure)"
        )
        raise RuntimeError("simulated worker crash")
    if  doc_id==3:
        time.sleep(3.0)
    pairs= [(word, 1) for word in text.split()]
    return pairs
def run_with_retry(pool, doc_id, text , max_attept=3):
    for attempt in range(1, max_attept+1):
        async_result= pool.apply_async(
            falky_map_task,
            (doc_id,text,attempt)
        )
        try:
            return async_result.get(timeout=map_timeout)
        except mp.TimeoutError:
            print(
                f"[MASTER] doc {doc_id} attempt #{attempt} "
                f"is a STRAGGLER (> {map_timeout}s) "
                f"-- launching a BACKUP copy"
            )
            backup_result = pool.apply_async(
                falky_map_task,
                (doc_id, text, attempt),
            )
            return backup_result.get()
        except  Exception as e:
            print(
                f"[MASTER] doc {doc_id} attempt #{attempt} "
                f"CRASHED ({e}); "
                f"re-executing on a fresh worker"
            )
            continue
    raise RuntimeError(
        f"doc {doc_id} failed after {max_attept} attempts"
    )


def main():
    with mp.Pool(processes=4) as pool:
        all_pairs =[]
        for doc_id, text in enumerate(DOCUMENTS):
            pairs= run_with_retry(
                pool,
                doc_id,
                text
            )
            all_pairs.extend(pairs)
        
        counts = {}
        for word, count in all_pairs:
            counts[word]= counts.get(word,0)+count
        print(
        "\n[MASTER] All map tasks eventually succeeded. "
        "FINAL WORD COUNTS:"
        )
        for word, count in sorted(
            counts.items(),
            key=lambda kv: -kv[1]
        ):
            print(f"{word:12s} {count}")
            
if __name__ == "__main__":
    main()
